# Python
__pycache__/
*.pyc
*.pyo

# Entornos virtuales (cada uno crea el suyo, los README lo explican)
.venv/
venv/
env/

# Editores
.idea/
.vscode/

# Basura del sistema
.DS_Store
Thumbs.db
desktop.ini

# Salidas del preprocesador: se regeneran ejecutandolo y son enormes
output/

# Informe de validacion: lo rehace python -m Clustering_jerarquico.validacion
resultados_clustering/validacion.html

# Matrices regeneradas en local para probar la limpieza del texto y las
# variantes de representacion. Se rehacen con:
#   python -m vectorizacion --datos <ruta-csv-preprocesado> --salida <carpeta> [--quitar-vacias] [--sublinear-tf]
resultados_tfidf_limpio/
resultados_tfidf_limpio_sinvacias/
resultados_var_*/

# Salidas del banco de pruebas: python -m experimentos --entrada <carpeta>
resultados_experimentos*/

# Los XML de CLEF NO van al repo. Se descargan aparte y se dejan en local.
data_*/
subject*.xml
*.zip

# La validación completa se regenera; conservar el informe anterior.
resultados_clustering_completo/validacion.html

# Matrices de prueba generadas en local al recorrer la cadena entera.
resultados_prueba*/

# Graficos de consulta, en la raiz. Se rehacen con:
#   python -m experimentos.consultar "<texto>" --entrada <carpeta> --grafico <fichero>
# Solo la raiz: los plots de resultados_clustering_completo si van al repo.
/consulta*.png
/cerca.png
/lejos.png

# Enlace al diccionario de jerga que algunos crean para lanzar el preprocesador
# desde la raiz. Es de cada maquina; el fichero de verdad vive en preprocesador/.
/chat_words.json

# Plots que deja "python -m Clustering_jerarquico experimentar" al lanzarlo en
# local para mirar la salida. Los de plots/{average,complete,single,ward} que ya
# estan commiteados se quedan: esto solo evita que cada ejecucion anada un juego
# nuevo con el nombre de la distancia por delante.
resultados_clustering_completo/plots/cosine_*/
